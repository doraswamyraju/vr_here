# ------------------------------------------------------------------
# CRITICAL SECURITY: Exclude files that should NEVER be committed.
# ------------------------------------------------------------------

# 1. Database/Credential Files
# Prevents accidental sharing of credentials (db_connect.php)
api/db_connect.php

# 2. Local Configuration Files
.vscode/
.env*
.DS_Store

# 3. Frontend Dependencies
# The node_modules folder is huge and should be generated on the server.
node_modules/
/frontend/node_modules
/frontend/package-lock.json
/backend/node_modules

# NOTE: /frontend/build is NO LONGER IGNORED, so it will be pushed!

# 4. Uploaded Files
/backend/uploads/

# 5. Swift / iOS Build Artifacts and Xcode User Settings
VRHereIOS/build/
VRHereIOS/.build/
VRHereIOS/.swiftpm/
**/DerivedData/
**/*.xcuserstate
**/xcuserdata/

# 6. Android/IntelliJ IDE configs (untracked files)
**/gradle-daemon-jvm.properties
.idea/
**/codeStyles/
**/deviceManager.xml
**/inspectionProfiles/
